# Optional local configuration. Copy to .env and keep it private.
PORT=4180
HOST=127.0.0.1
APP_URL=http://127.0.0.1:4180
DATA_PATH=./data/opennoir.sqlite
# Optional, high-entropy 32+ characters. Otherwise generated privately in SQLite.
# BETTER_AUTH_SECRET=
# For initial setup on a remotely hosted HTTPS installation only:
# SETUP_TOKEN=
# Optional local Ollama model. Configure a model you have installed.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=
# Stripe test mode only. Live keys are deliberately not accepted.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
